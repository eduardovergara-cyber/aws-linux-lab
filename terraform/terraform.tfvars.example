# Plantilla de variables.
# 1. Copia este archivo como terraform.tfvars (en esta misma carpeta).
# 2. Reemplaza los valores de ejemplo por los tuyos.
# terraform.tfvars está en .gitignore: NUNCA se sube a GitHub.

# Tu IP pública con /32. Averíguala con:  (Invoke-RestMethod https://checkip.amazonaws.com).Trim()
allowed_ssh_cidr = "203.0.113.10/32"

# Opcionales (ya tienen valor por defecto en variables.tf):
# aws_region      = "us-east-1"
# instance_type   = "t3.micro"
# public_key_path = "~/.ssh/aws-linux-lab.pub"
# admin_username  = "labadmin"
